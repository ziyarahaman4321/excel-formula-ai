# Copy to .env.local for local development.
# On Vercel, add these under Project > Settings > Environment Variables, then redeploy.

# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Optional: model --------------------------------------------------------
# Defaults to claude-haiku-4-5-20251001 (fast and cheap).
# ANTHROPIC_MODEL=

# --- Optional: limits -------------------------------------------------------
# FREE_DAILY_LIMIT=5        # answers per visitor per day
# PRO_DAILY_LIMIT=200       # fair-use cap per licence key per day
# GLOBAL_DAILY_CAP=3000     # whole-site cap, protects your API balance

# --- Durable counters (strongly recommended in production) -------------------
# Without these, limits are kept in memory and reset whenever Vercel starts a
# new instance. Add the Upstash Redis integration from the Vercel Marketplace
# and it sets these for you (KV_REST_API_URL / KV_REST_API_TOKEN also work).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Pro plan (Lemon Squeezy) -----------------------------------------------
# Pro stays hidden until LEMONSQUEEZY_STORE_ID is set.
# LEMONSQUEEZY_STORE_ID=        # numeric store id; only keys from this store unlock Pro
# LEMONSQUEEZY_PRODUCT_ID=      # optional; comma-separated product ids to accept
# CHECKOUT_URL=                 # your product's checkout link, used by the "Get Pro" button
# PRO_PRICE="$5 / month"        # text shown on the pricing card
